# Docktopus — Painel de Provisionamento Dinâmico de Ambientes Docker

PORT=3000
# Desenvolvimento local (API fora do Docker). Em compose use DOCKER_HOST do socket-proxy.
DOCKER_SOCKET=/var/run/docker.sock
# Em produção use: /var/apps/projetos
PROJECTS_ROOT=./projects
PROXY_NETWORK=proxy

# Traefik (infra/traefik)
# Use 80 em produção. Se a porta estiver ocupada localmente, use 8088.
TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8080
PUBLIC_SCHEME=http

# Stack infra/docktopus (API + Next + proxy do socket)
# O caminho abaixo precisa existir no host e ser o mesmo dentro do container da API.
HOST_PROJECTS_ROOT=/var/lib/docktopus/projects
DOCKTOPUS_HOST=docktopus.localhost
DOCKTOPUS_WEB_PORT=3001
DOCKTOPUS_API_TOKEN=""
DOCKTOPUS_UI_PASSWORD=""
DOCKTOPUS_SESSION_SECRET=""
# true só quando o painel estiver em HTTPS
DOCKTOPUS_COOKIE_SECURE=false

# Auto-generated by Docktopus — do not edit manually
# Project: {{projectName}} | Domain: {{domain}} | ID: {{projectId}}

services:
{{#if hasWebserver}}
  web:
    image: {{webserverImage}}
    container_name: {{projectId}}-web
    restart: unless-stopped
    volumes:
      - ./app:/usr/share/nginx/html:ro
{{#if isNginx}}
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
{{/if}}
{{#if isApache}}
      - ./app:/var/www/html:ro
{{/if}}
    depends_on:
      - app
    networks:
      - proxy
      - internal
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=proxy"
      - "traefik.http.routers.{{projectId}}.rule=Host(`{{domain}}`)"
      - "traefik.http.routers.{{projectId}}.entrypoints=web"
      - "traefik.http.services.{{projectId}}.loadbalancer.server.port=80"
      - "docktopus.project.id={{projectId}}"
      - "docktopus.project.name={{projectName}}"
{{/if}}

  app:
    image: {{runtimeImage}}
    container_name: {{projectId}}-app
    restart: unless-stopped
    working_dir: /app
    volumes:
      - ./app:/app
{{#if hasEnvVars}}
    environment:
{{#each envVars}}
      - {{this.key}}={{this.value}}
{{/each}}
{{/if}}
{{#if hasDatabase}}
    depends_on:
      - db
{{/if}}
    networks:
{{#unless hasWebserver}}
      - proxy
{{/unless}}
      - internal
{{#unless hasWebserver}}
    labels:
      - "traefik.enable=true"
      - "traefik.docker.network=proxy"
      - "traefik.http.routers.{{projectId}}.rule=Host(`{{domain}}`)"
      - "traefik.http.routers.{{projectId}}.entrypoints=web"
      - "traefik.http.services.{{projectId}}.loadbalancer.server.port={{runtimePort}}"
      - "docktopus.project.id={{projectId}}"
      - "docktopus.project.name={{projectName}}"
{{else}}
    labels:
      - "traefik.enable=false"
      - "docktopus.project.id={{projectId}}"
      - "docktopus.project.name={{projectName}}"
{{/unless}}
{{#if isNode}}
    command: ["sh", "-c", "if [ -f package.json ]; then npm install && npm start; else node -e \"require('http').createServer((q,s)=>s.end('Node ready')).listen({{runtimePort}},'0.0.0.0')\"; fi"]
    expose:
      - "{{runtimePort}}"
{{/if}}
{{#if isPhp}}
    command: ["php", "-S", "0.0.0.0:{{runtimePort}}", "-t", "/app"]
    expose:
      - "{{runtimePort}}"
{{/if}}
{{#if isPython}}
    command: ["sh", "-c", "if [ -f requirements.txt ]; then pip install -r requirements.txt; fi; python -m http.server {{runtimePort}} --bind 0.0.0.0"]
    expose:
      - "{{runtimePort}}"
{{/if}}
{{#if isGo}}
    command: ["sh", "-c", "if [ -f go.mod ]; then go run .; else printf '%s\\n' 'package main' 'import \"net/http\"' 'func main() { http.HandleFunc(\"/\", func(w http.ResponseWriter, r *http.Request) { w.Write([]byte(\"Go runtime ready\")) }); http.ListenAndServe(\":{{runtimePort}}\", nil) }' > main.go && go run main.go; fi"]
    expose:
      - "{{runtimePort}}"
{{/if}}

{{#if hasDatabase}}
  db:
    image: {{databaseImage}}
    container_name: {{projectId}}-db
    restart: unless-stopped
{{#if isMysql}}
    environment:
      MYSQL_ROOT_PASSWORD: {{dbRootPassword}}
      MYSQL_DATABASE: {{dbName}}
      MYSQL_USER: {{dbUser}}
      MYSQL_PASSWORD: {{dbPassword}}
    volumes:
      - db_data:/var/lib/mysql
    expose:
      - "3306"
{{/if}}
{{#if isPostgres}}
    environment:
      POSTGRES_DB: {{dbName}}
      POSTGRES_USER: {{dbUser}}
      POSTGRES_PASSWORD: {{dbPassword}}
    volumes:
      - db_data:/var/lib/postgresql/data
    expose:
      - "5432"
{{/if}}
{{#if isRedis}}
    volumes:
      - db_data:/data
    expose:
      - "6379"
    command: ["redis-server", "--appendonly", "yes"]
{{/if}}
    networks:
      - internal
    labels:
      - "traefik.enable=false"
      - "docktopus.project.id={{projectId}}"
      - "docktopus.role=database"
{{/if}}

networks:
  proxy:
    external: true
    name: {{proxyNetwork}}
  internal:
    driver: bridge
    name: {{projectId}}-internal

{{#if hasDatabase}}
volumes:
  db_data:
    name: {{projectId}}-db-data
{{/if}}
